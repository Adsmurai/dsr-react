{
  "name": "adsmurai-dsr-react",
  "version": "2.0.0",
  "description": "Adsmurai Design System React - UI component library wrapping DSR components",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./enums": {
      "import": {
        "types": "./dist/enums.d.ts",
        "default": "./dist/enums.js"
      },
      "require": {
        "types": "./dist/enums.d.ts",
        "default": "./dist/enums.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.cjs"
      }
    },
    "./styles": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./preset": {
      "import": "./dist/preset.js",
      "require": "./dist/preset.cjs"
    }
  },
  "files": [
    "dist",
    "AI-INSTRUCTIONS.md",
    "PATTERNS.md",
    "THEMING.md",
    "UI-CONTRACT.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "tokens": "node scripts/generate-tokens.mjs",
    "build": "npm run tokens && tsc -p tsconfig.build.json && vite build && npm run styles && npm run contract",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "prepublishOnly": "npm run build",
    "publish:snapshot": "dotenv -- npm publish --tag snapshot",
    "publish:release": "dotenv -- npm publish",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "styles": "node scripts/compose-styles.mjs",
    "contract": "node scripts/generate-ui-contract.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <19.0.0",
    "react-dom": ">=18.0.0 <19.0.0",
    "react-hook-form": ">=7.0.0",
    "tailwindcss": ">=3.0.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
